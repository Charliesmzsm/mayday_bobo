  "scheduler": {
    "enabled_setting": "AutoActions",
    "default_profile": "standard",
    "profiles": {
      "quiet": {
        "wait_range_ms": [
          45000,
          90000
        ]
      },
      "standard": {
        "wait_range_ms": [
          20000,
          45000
        ]
      },
      "lively": {
        "wait_range_ms": [
          12000,
          25000
        ]
      }
    },
    "wait_distribution": "uniform",
    "schedule_next": "after_random_action_completes",
    "wait_counts_during_manual_actions": false,
    "pointer_quiet_ms": 3000,
    "manual_interaction_grace_ms": 5000,
    "pointer_exclusion_margin_logical_px": 32,
    "eligible_state": "neutral_idle",
    "exclude_states": [
      "dragging",
      "pointer_held",
      "menu_open",
      "paused",
      "hidden",
      "session_locked"
    ],
    "recent_random_history": 2,
    "when_history_exhausts_pool": "relax_second_last_first_but_never_repeat_last",
    "when_no_candidate": {
      "action": "idle",
      "retry_range_ms": [
        5000,
        10000
      ]
    },
    "missed_events": "discard_and_schedule_future_only",
    "rate_limit_scope": "all_starts_including_manual",
    "on_disabling_auto": "cancel_random_and_micro_actions_then_idle_breathe",
    "on_resume": "wait_for_pointer_quiet_and_manual_grace_then_schedule_new_wait",
    "candidate_order": [
      "context_filter",
      "cooldown_filter",
      "rate_limit_filter",
      "history_filter",
      "weighted_sample"
    ]
  },
  "micro_actions": {
    "blink": {
      "wait_range_ms": [
        5000,
        12000
      ],
      "schedule_next": "after_completion_or_deferral",
      "requires_auto_actions": true,
      "eligible_state": "neutral_idle",
      "interrupt_emotion": false,
      "combine_with_gaze": false
    },
    "sleepy_yawn": {
      "requires_auto_actions": true,
      "requires_pointer_quiet_ms": 120000,
      "eligibility_check_wait_ms": [
        90000,
        180000
      ],
      "start_probability_on_check": 0.2,
      "shares_random_exclusion_rules": true
    }
  },
  "interaction": {
    "single_click": "wave",
    "single_click_commit": "after_system_double_click_time_if_no_second_click",
    "double_click": {
      "surprise_attempt_probability": 0.3,
      "fallback": "happy_bounce",
      "respect_surprise_rate_limits": true
    },
    "manual_queue_length": 0,
    "drag_cancels_animation": true,
    "gaze_resume_delay_ms": [
      150,
      250
    ],
    "gaze_during_emotion": false,
    "wander_enabled_by_default": false,
    "wander_pool_separate": true
  },
  "runtime": {
    "clock": "monotonic",
    "timer_poll_interval_ms_target": 16,
    "timer_interval_is_not_animation_fps": true,
    "frame_selection": "elapsed_time_from_action_start",
    "on_skipped_frames": "advance_to_current_time_and_fire_completion_once",
    "cache": "bounded_current_actions_and_current_scale",
    "crossfade_full_body_as_default": false,
    "old_atlas_adapter_required": true
  }
}
